#SkyX cfg file.

#SkyX version field
SkyXVersion=0.4.0

#Main options field
<float>TimeMultiplier=0.01
<vector3>Time=12.00x7.5x20.5 ; current-time 'x' sunrise time 'x' sunset time
<float>MoonPhase=0

# Astronomical sun and moon (ported from Caelum). If 'Latitude' is present, the sun and moon trajectories and the moon phase
# are calculated from latitude (degrees, -90..90), day of year (1..365) and the time of day (in solar time);
# the sunrise and sunset hours of 'Time' and the 'MoonPhase' above are then ignored.
<float>Latitude=45
<int>DayOfYear=150

#Atmoshperic options
<float>_InnerRadius=9.77501
<float>_OuterRadius=10.2963
<float>_HeightPosition=0.01
<float>_RayleighMultiplier=0.0022
<float>_MieMultiplier=0.000675
<float>_SunIntensity=30
<float>_G=-0.991
<float>_Exposure=2.0
<float>_NumerOfSamples=4
<vector3>_WaveLength=0.57fx0.54fx0.44

#Layered clouds
<bool>layeredclouds=false
<float>lHeight=100
<float>Scale=0.001
<float>TimeMultiplier=0.125
<float>DistanceAttenuation=0.05
<float>DetailAttenuation=1
<float>HeightVolume=0.25
<float>VolumetricDisplacement=0.01
<vector2>WindDirection=1x1

#Volumetric clouds
<bool>volClouds=true 
<vector2>vHeight=825x3500
<float>WindSpeed=80.0
<bool>AutoUpdate=false
<degree>WindDirection=0
<vector3>AmbientColor=0.63x0.63x0.7
<vector4>LightResponse=0.25x0.2x1.0x0.1
<vector4>AmbientFactors=0.45x0.3x0.6x1.0
<vector2>Wheater=0.1x0.6
<bool>DelayedResponse=false

#Lightnings 
<bool>lightnings=false
<float>AverageLightningApparitionTime=1.5
<vector3>LightningColor=1x0.925x0.85
<float>LightningTimeMultiplier=2.0

# Precipitation system ported from Caelum (see SkyX/Precipitation.*)
# Wind of the precipitation is tied to the volumetric clouds wind. Intensity is controlled in the 'Sky settings' window.
# All lines are optional - without them the 'rain' preset is used.
# Texture is 'precipitation_X.png', X is: drizzle/rain/snow/snowgrains/icecrystals/icepellets/hail/smallhail
# CameraSpeedScale: how much moving the player changes the direction of the drops
# AutoDisableThreshold: compositor is disabled below this intensity (switching is expensive); negative = always on
PrecipitationTextureName=precipitation_rain.png
<color>PrecipitationColor=0.7x0.7x0.7
<float>PrecipitationFallingSpeed=0.85
<vector3>PrecipitationCameraSpeedScale=1x1x1
<float>PrecipitationIntensity=0
<float>PrecipitationAutoDisableThreshold=0.001
